digraph G { graph [rankdir=LR, splines=true, nodesep=0.7, ranksep=1.3, fontname="Helvetica", labelloc=t, fontsize=20, pad=0.4, bgcolor=white];
node [shape=plain, fontname="Helvetica", fontsize=12]; edge [fontname="Helvetica", fontsize=11, color="#333333"];
label="ERD - Project Laravel PBO2 (db_pbo2_5b)";
periode [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333">
<TR><TD COLSPAN="3" BGCOLOR="#2e7d32"><FONT COLOR="white"><B>periode</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" WIDTH="30"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="periode" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">periode</TD><TD ALIGN="LEFT" PORT="periode_e"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="singkatan" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">singkatan</TD><TD ALIGN="LEFT" PORT="singkatan_e"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT" PORT="status_e"><FONT COLOR="#555555">boolean (default 0)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at / updated_at" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT" PORT="created_at / updated_at_e"><FONT COLOR="#555555">timestamp</FONT></TD></TR></TABLE>>];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333">
<TR><TD COLSPAN="3" BGCOLOR="#1565c0"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" WIDTH="30"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#555555">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="name" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_e"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT" PORT="email_e"><FONT COLOR="#555555">varchar(255), unique</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email_verified_at" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">email_verified_at</TD><TD ALIGN="LEFT" PORT="email_verified_at_e"><FONT COLOR="#555555">timestamp, null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="password" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT" PORT="password_e"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="remember_token" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">remember_token</TD><TD ALIGN="LEFT" PORT="remember_token_e"><FONT COLOR="#555555">varchar(100), null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at / updated_at" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">created_at / updated_at</TD><TD ALIGN="LEFT" PORT="created_at / updated_at_e"><FONT COLOR="#555555">timestamp</FONT></TD></TR></TABLE>>];
sessions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333">
<TR><TD COLSPAN="3" BGCOLOR="#ef6c00"><FONT COLOR="white"><B>sessions</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id" WIDTH="30"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT" PORT="id_e"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id" WIDTH="30"><FONT POINT-SIZE="10" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT" PORT="user_id_e"><FONT COLOR="#555555">bigint, null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ip_address" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT" PORT="ip_address_e"><FONT COLOR="#555555">varchar(45), null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_agent" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">user_agent</TD><TD ALIGN="LEFT" PORT="user_agent_e"><FONT COLOR="#555555">text, null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="payload" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">payload</TD><TD ALIGN="LEFT" PORT="payload_e"><FONT COLOR="#555555">longtext</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_activity" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">last_activity</TD><TD ALIGN="LEFT" PORT="last_activity_e"><FONT COLOR="#555555">int</FONT></TD></TR></TABLE>>];
password_reset_tokens [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#333333">
<TR><TD COLSPAN="3" BGCOLOR="#6a1b9a"><FONT COLOR="white"><B>password_reset_tokens</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="email" WIDTH="30"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT"><B>email</B></TD><TD ALIGN="LEFT" PORT="email_e"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="token" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">token</TD><TD ALIGN="LEFT" PORT="token_e"><FONT COLOR="#555555">varchar(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at" WIDTH="30">&nbsp;</TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_e"><FONT COLOR="#555555">timestamp, null</FONT></TD></TR></TABLE>>];
users:id_e:e -> sessions:user_id:w [dir=both, arrowtail=tee, arrowhead=crowodot, headlabel="N", taillabel="1", labeldistance=2.2];
}
